<div class='layout layout--row layout--stretch gap--small'>
  {% if e %}
  <div class='flex flex--col flex--center stretch-y w--[40cqw] no-shrink'>
    <img class='image image-dither image--contain h--full w--full' src='{{ e.image }}' />
  </div>
  <div class='flex flex--col flex--left gap--xsmall stretch-y grow'>
    <span class='value value--xsmall lg:value--small'>{{ e.id }}</span>
    <span class='title title--small lg:title--base' data-clamp='4'>{{ e.title | default: 'Details unavailable' }}</span>
    {% if e.method != blank %}<span class='label label--small lg:label--base'>{{ e.method }}{% if e.resolution != blank %} · {{ e.resolution }}{% endif %}</span>{% endif %}
  </div>
  {% else %}
  <span class='title title--small'>{{ empty_msg }}</span>
  {% endif %}
</div>
<div class='title_bar'>
  <img class='image' src='data:image/svg+xml;base64,{{ pdb_icon | base64_encode }}' />
  <span class='title'>{{ title }}</span>
</div>
