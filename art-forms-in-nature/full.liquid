<div class="layout layout--row portrait:layout--col layout--stretch gap--medium">
  <div class="flex flex--center flex--center-x stretch-y portrait:stretch-x af-pic af-pic--full">
    <img class="image image-dither af-img" src="{{ img }}" alt="{{ p_name }}" />
  </div>
  <div class="flex flex--col flex--left gap--medium portrait:stretch-x af-text">
    <div class="flex flex--col flex--left gap--small lg:gap--medium">
      <span class="label label--small lg:label--base label--inverted">Plate {{ p_num }} of 100</span>
      <span class="title title--xlarge lg:title--xxlarge">{{ p_name }}</span>
      <span class="label lg:label--large label--underline">{{ p_common }}</span>
      <span class="description lg:description--xlarge" data-clamp="7">{{ p_note }}</span>
    </div>
    <span class="label label--small lg:label--base label--gray 1bit:text--black" data-clamp="2">{{ credit }}</span>
  </div>
</div>
<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ leaf_icon | base64_encode }}" />
  <span class="title">{{ title }}</span>
  <span class="instance">Haeckel · Plate {{ p_num }}</span>
</div>
