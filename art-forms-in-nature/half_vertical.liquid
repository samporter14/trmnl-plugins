<div class="layout layout--col layout--stretch gap--small">
  <div class="flex flex--center stretch-x af-pic af-pic--hv">
    <img class="image image-dither af-img" src="{{ img }}" alt="{{ p_name }}" />
  </div>
  <div class="flex flex--col flex--left gap--xsmall stretch-x">
    <span class="title title--small lg:title--base">{{ p_name }}</span>
    <span class="label label--small lg:label--base label--underline">{{ p_common }} · Plate {{ p_num }}</span>
    <span class="description" data-clamp="4">{{ p_note }}</span>
  </div>
</div>
<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ leaf_icon | base64_encode }}" />
  <span class="title">{{ title }}</span>
</div>
