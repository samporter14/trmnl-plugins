<div class="layout layout--col layout--top layout--stretch-x gap--space-between">
  {% if f %}
  <div class="flex flex--col flex--left gap--xsmall stretch-x">
    <span class="label label--small label--gray 1bit:text--black" data-clamp="1">{% if f.preprint %}Preprint · {% endif %}{{ f.venue }} · {{ f.when }}</span>
    <span class="title title--small" data-clamp="4">{{ f.title }}</span>
  </div>
  {% else %}
  <span class="title title--small">{{ empty_msg }}</span>
  {% endif %}
  {% if f.preprint %}<span class="label label--small label--inverted">Not peer reviewed</span>{% endif %}
</div>
<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ virus_icon | base64_encode }}" />
  <span class="title">{{ title }}</span>
</div>
