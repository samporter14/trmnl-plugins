<div class="layout layout--col layout--top layout--stretch-x gap--space-between">
  {% if f %}
  <div class="flex flex--col flex--left gap--xsmall stretch-x">
    <span class="label label--small label--gray 1bit:text--black" data-clamp="1">{% if f.preprint %}Preprint · {% endif %}{{ f.venue }} · {{ f.when }}</span>
    <span class="title title--small lg:title--large" data-clamp="4" data-clamp-lg-portrait="8">{{ f.title }}</span>
    {% if f.abstract != blank %}<span class="description hidden lg:portrait:block" data-clamp="6">{{ f.abstract }}</span>{% endif %}
  </div>
  {% else %}
  <span class="title title--small lg:title--large">{% if all_failed %}{{ fail_msg }}{% else %}{{ empty_msg }}{% endif %}</span>
  {% endif %}
  {% if f.preprint %}<div class="flex flex--row"><span class="label label--small label--inverted">Not peer reviewed</span></div>{% endif %}
</div>
<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ virus_icon | base64_encode }}" />
  <span class="title">{{ title }}</span>
</div>
