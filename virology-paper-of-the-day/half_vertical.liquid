<div class="layout layout--col layout--top layout--stretch-x gap--space-between">
  {% if f %}
  <div class="flex flex--col flex--left gap--small stretch-x">
    {% if f.preprint %}<span class="label label--small label--inverted">Preprint · not peer reviewed</span>{% endif %}
    <span class="label label--small lg:label--base label--gray 1bit:text--black">Newest from {{ featured_source }} · {{ f.when }}</span>
    <span class="title title--small lg:title--base" data-clamp="4">{{ f.title }}</span>
    <span class="label label--small lg:label--base" data-clamp="2">{{ f.authors }} · {{ f.venue }}</span>
    {% if f.abstract != blank %}<span class="description" data-clamp="6">{{ f.abstract }}</span>{% endif %}
  </div>
  {% else %}
  <span class="title title--small">{{ empty_msg }}</span>
  {% endif %}
  <span class="label label--small label--gray 1bit:text--black" data-clamp="2">{{ basis }}</span>
</div>
<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ virus_icon | base64_encode }}" />
  <span class="title">{{ title }}</span>
</div>
