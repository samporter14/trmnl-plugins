<div class="layout layout--col layout--top layout--stretch-x gap--space-between">
  {% if ok %}
  <div class="flex flex--col flex--left gap--xsmall stretch-x">
    <span class="title title--small lg:title--base">Week ending {{ week_short }}</span>
    <span class="label label--small lg:label--base label--gray 1bit:text--black" data-clamp="2">{{ where_line }}</span>
  </div>
  {% for p in pathogens %}
  <div class="flex flex--col flex--left gap--xsmall stretch-x">
    <span class="title title--small lg:title--base">{{ p.name }}</span>
    {% if p.current %}
    <div class="flex flex--row flex--between flex--center-y stretch-x">
      <span class="value value--xsmall lg:value--large">{{ p.category }}</span>
      <span class="label label--small lg:label--base">WVAL {{ p.wval }}</span>
    </div>
    {% if p.level > 0 %}<div class="progress-dots progress-dots--xsmall lg:progress-dots--small"><div class="track">{% for i in (1..5) %}<div class="dot{% if i <= p.level %} dot--filled{% endif %}"></div>{% endfor %}</div></div>{% endif %}
    {% elsif p.has_data %}
    <span class="label label--small">No data this week (last: {{ p.category }}, {{ p.as_of }})</span>
    {% else %}
    <span class="label label--small">No data</span>
    {% endif %}
  </div>
  {% endfor %}
  {% else %}
  <span class="title title--small">{{ error | default: "No data" }}</span>
  {% endif %}
  <span class="label label--small label--gray 1bit:text--black" data-clamp="3">{% if note != blank %}{{ note }} {% endif %}Not case counts. {{ credit }}</span>
</div>
<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ ww_icon | base64_encode }}" />
  <span class="title">{{ title }}</span>
</div>
