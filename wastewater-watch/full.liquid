{% if ok %}
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
{% endif %}
<div class="layout layout--col layout--top layout--stretch-x gap--space-between">
  {% if ok %}
  <div class="flex flex--row flex--between flex--center-y stretch-x gap--small">
    <span class="title title--small lg:title--base">Week ending {{ week_label }}</span>
    <span class="label label--small lg:label--base label--gray 1bit:text--black" data-clamp="1">{{ where_line }}</span>
  </div>
  <div class="grid grid--cols-3 gap--medium stretch-x">
    {% for p in pathogens %}
    <div class="flex flex--col flex--left gap--xsmall">
      <span class="title title--small lg:title--base">{{ p.name }}{% if p.disease != blank %} <span class="label label--small lg:label--base label--gray 1bit:text--black">{{ p.disease }}</span>{% endif %}</span>
      {% if p.current %}
      <span class="value value--small lg:value--xlarge lg:portrait:value--large">{{ p.category }}</span>
      {% if p.level > 0 %}<div class="progress-dots progress-dots--small"><div class="track">{% for i in (1..5) %}<div class="dot{% if i <= p.level %} dot--filled{% endif %}"></div>{% endfor %}</div></div>{% endif %}
      <span class="label label--small lg:label--base">WVAL {{ p.wval }}{% if p.prev != blank %} · {{ p.prev_week }}: {{ p.prev }}{% endif %}</span>
      {% elsif p.has_data %}
      <span class="value value--xsmall lg:value--base">No data this week</span>
      <span class="label label--small lg:label--base">Last: {{ p.category }} {{ p.wval }} ({{ p.as_of }})</span>
      {% else %}
      <span class="value value--xsmall lg:value--base">No data</span>
      {% endif %}
      {% if p.hist.size > 1 %}<div id="ww-chart-{{ forloop.index }}" class="w--full h--24 lg:h--64 lg:portrait:h--96"></div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="flex flex--col flex--center gap--small stretch">
    <span class="title lg:title--large">{{ error | default: "No data" }}</span>
    <span class="description lg:description--large">Checked CDC's wastewater data (data.cdc.gov) for {{ place }}. Check the county and state spelling, or this area may not have a reporting site.</span>
  </div>
  {% endif %}
  <div class="flex flex--col flex--left stretch-x">
    {% if note != blank %}<span class="label label--small lg:label--base label--underline" data-clamp="1">{{ note }}</span>{% endif %}
    {% if ok %}<span class="label label--small lg:label--base label--gray 1bit:text--black" data-clamp="1" data-clamp-lg="2">{% assign h0 = pathogens.first.hist %}Bars: weekly WVAL, {{ h0.first.first }} to {{ h0.last.first }}. {{ caveat }}</span>{% endif %}
    <span class="label label--small lg:label--base label--gray 1bit:text--black" data-clamp="1">{{ credit }}{% if other_sites != blank %} · Other site{% if site_count > 2 %}s{% endif %} here: {{ other_sites }}{% endif %}</span>
  </div>
</div>
<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ ww_icon | base64_encode }}" />
  <span class="title">{{ title }}</span>
  <span class="instance">SARS-CoV-2 · Influenza A · RSV</span>
</div>
{% if ok %}
<script type="text/javascript">
  (function () {
    var series = {{ pathogens | map: "hist" | json }};
    var ymax = {{ hist_max | default: 10 }};
    var draw = function () {
      if (!window.Highcharts) return;
      for (var i = 0; i < series.length; i++) {
        var el = document.getElementById("ww-chart-" + (i + 1));
        if (!el || !series[i] || series[i].length < 2) continue;
        Highcharts.chart(el, {
          chart: { type: "column", backgroundColor: "transparent", animation: false, spacing: [4, 0, 10, 0] },
          title: { text: null }, legend: { enabled: false }, credits: { enabled: false }, tooltip: { enabled: false },
          xAxis: { categories: series[i].map(function (d) { return d[0]; }), lineColor: "#000000", lineWidth: 1, tickLength: 0,
                   labels: { enabled: false } },
          yAxis: { min: 0, max: ymax, tickAmount: 3, title: { text: null }, gridLineColor: "#000000", gridLineDashStyle: "dot",
                   labels: { style: { fontSize: "14px", color: "#000000" } } },
          plotOptions: { series: { animation: false, enableMouseTracking: false, borderWidth: 0, color: "#000000",
                                   pointPadding: 0.1, groupPadding: 0.05 } },
          series: [{ data: series[i].map(function (d) { return d[1]; }) }]
        });
      }
    };
    if (document.readyState === "complete") draw(); else window.addEventListener("load", draw);
  })();
</script>
{% endif %}
