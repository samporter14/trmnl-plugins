<div class="layout layout--col layout--stretch layout--top gap--space-between">
  {% if error != blank and stops.size == 0 %}
  <span class="title title--small">{{ error }}</span>
  {% else %}
  <div class="flex flex--col flex--left gap--large">
    {% for sid in wanted_ids limit: 2 %}{% assign stop = stops | where: "id", sid | first %}
    <div class="flex flex--col flex--left flex--top gap--xsmall">
      <span class="title title--small lg:title--base" data-clamp="1">{% if stop.name != blank %}{{ stop.name }}{% else %}Stop {{ sid }}{% endif %}</span>
      {% if stop.name != blank %}<span class="label label--small label--gray 1bit:text--black">{% if stop.dir != blank %}{{ stop.dir }} · {% endif %}Stop {{ sid }}</span>{% endif %}
      {% if stop == nil or stop.routes.size == 0 %}<span class="label label--small label--gray 1bit:text--black">{{ stop.note | default: "No buses predicted" }}</span>{% endif %}
      {% for r in stop.routes limit: 3 %}
      <div class="flex flex--row flex--center-y gap--small">
        <span class="label label--filled lg:label--large">{{ r.route }}</span>
        <span class="value value--xsmall lg:value--base lg:portrait:value--large value--tnums">{{ r.times[0] }}</span>
        {% if r.times.size > 1 %}<span class="label label--gray 1bit:text--black lg:label--large">{% for t in r.times offset: 1 %}{{ t }}{% unless forloop.last %}, {% endunless %}{% endfor %}</span>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  <span class="label label--small">{{ legend }}</span>
</div>
<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ bus_icon | base64_encode }}" />
  <span class="title">{{ title }}</span>
  <span class="instance">As of {{ updated | default: "--" }}</span>
</div>
