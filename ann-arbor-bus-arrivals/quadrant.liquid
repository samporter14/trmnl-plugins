<div class="layout layout--col layout--stretch layout--top gap--space-between">
  {% if error != blank and stops.size == 0 %}
  <span class="title title--small">{{ error }}</span>
  {% else %}
  <div class="grid grid--cols-2 lg:portrait:grid--cols-1 gap--medium">
    {% for sid in wanted_ids limit: 2 %}{% assign stop = stops | where: "id", sid | first %}
    <div class="flex flex--col flex--left flex--top gap--xsmall">
      <span class="label label--small lg:label--base" data-clamp="1">{% if stop.name != blank %}{{ stop.name }}{% else %}Stop {{ sid }}{% endif %}</span>
      {% if stop == nil or stop.routes.size == 0 %}<span class="label label--small label--gray 1bit:text--black">{{ stop.note | default: "No buses predicted" }}</span>{% endif %}
      {% for r in stop.routes limit: 3 %}
      <div class="{% if forloop.index == 3 %}hidden lg:flex{% else %}flex{% endif %} flex--row flex--center-y gap--small">
        <span class="label label--filled lg:label--large">{{ r.route }}</span>
        <span class="value value--xsmall lg:value--base value--tnums">{{ r.times[0] }}</span>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  <span class="label label--small">{{ legend }}</span>
</div>
<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ bus_icon | base64_encode }}" />
  <span class="title">{{ title }}</span>
  <span class="instance">As of {{ updated | default: "--" }}</span>
</div>
