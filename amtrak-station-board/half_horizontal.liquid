<div class='layout layout--col layout--top layout--stretch-x'>
  {% if error != blank %}
  <span class='title title--small'>{{ error }}</span>
  {% elsif upcoming.size == 0 and departed.size == 0 %}
  <div class='flex flex--col flex--center gap--xsmall stretch'>
    <span class='title title--small'>{{ empty_msg }}</span>
    <span class='description text--center'>{{ empty_help }}</span>
  </div>
  {% else %}
  <table class='table table--small lg:table--base' data-table-limit='true'>
    <thead>
      <tr>
        <th class='w--[56px] lg:w--[80px]'><span class='title title--small'>Train</span></th>
        <th><span class='title title--small'>Route</span></th>
        <th><span class='title title--small'>To / from</span></th>
        <th><span class='title title--small'>Sched</span></th>
        <th><span class='title title--small'>Expected</span></th>
      </tr>
    </thead>
    <tbody>
      {% for r in upcoming %}
      <tr>
        <td><span class='label'><b>{{ r.num }}</b></span></td>
        <td><span class='label' data-clamp='1'>{{ r.route }}</span></td>
        <td><span class='label' data-clamp='1'>{{ r.to }}</span></td>
        <td><span class='label'>{{ r.sched }}</span></td>
        <td>{% if r.late %}<span class='label label--filled'>{{ r.est }} {{ r.delay_short }}</span>{% elsif r.ends_here and r.changed %}<span class='label'>{{ r.est }}</span>{% else %}<span class='label'>On time</span>{% endif %}</td>
      </tr>
      {% endfor %}
      {% for r in departed %}
      <tr>
        <td><span class='label label--gray 1bit:text--black 2bit:text--gray-30'><b>{{ r.num }}</b></span></td>
        <td><span class='label label--gray 1bit:text--black 2bit:text--gray-30' data-clamp='1'>{{ r.route }}</span></td>
        <td><span class='label label--gray 1bit:text--black 2bit:text--gray-30' data-clamp='1'>{{ r.to }}</span></td>
        <td><span class='label label--gray 1bit:text--black 2bit:text--gray-30'>{{ r.sched }}</span></td>
        <td><span class='label label--gray 1bit:text--black 2bit:text--gray-30'>{{ r.status }} {{ r.est }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</div>
<div class='title_bar'>
  <img class='image' src='data:image/svg+xml;base64,{{ train_icon | base64_encode }}' />
  <span class='title'>{{ board_title }}</span>
  <span class='instance'>{{ as_of_text }}</span>
</div>
