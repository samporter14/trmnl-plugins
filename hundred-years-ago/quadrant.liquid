{% if ok %}
<div class='layout layout--col layout--top portrait:hidden'>
  <img class='image image-dither w--full' src='{{ image_top }}' alt='{{ paper }}, {{ date_label }}, front page' />
</div>
<div class='layout layout--col layout--center hidden portrait:flex'>
  <img class='image image-dither image--contain w--full h--full' src='{{ image_page }}' alt='{{ paper }}, {{ date_label }}, front page' />
</div>
{% else %}
<div class='layout layout--col layout--center'>
  <span class='label text--center'>{{ empty_msg }}</span>
</div>
{% endif %}
<div class='title_bar'>
  <img class='image' src='data:image/svg+xml;base64,{{ hya_icon | base64_encode }}' />
  <span class='title'>{% if ok %}{{ date_short }}{% else %}{{ title }}{% endif %}</span>
</div>
