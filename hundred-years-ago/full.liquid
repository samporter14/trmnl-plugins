{% if ok %}
<div class='layout layout--col layout--top'>
  <img class='image image-dither w--full' src='{{ image_top }}' alt='{{ paper }}, {{ date_label }}, front page' />
</div>
{% else %}
<div class='layout layout--col layout--center gap--small'>
  <span class='title lg:title--large text--center'>{{ empty_msg }}</span>
  <span class='description lg:description--large text--center'>Front pages come from Chronicling America at the Library of Congress. Pick another paper in the plugin settings.</span>
</div>
{% endif %}
<div class='title_bar'>
  <img class='image' src='data:image/svg+xml;base64,{{ hya_icon | base64_encode }}' />
  {% if ok %}
  <span class='title'>{{ paper }}{% if place != blank %}, {{ place }}{% endif %}</span>
  <span class='instance'>{{ date_label }} · {{ when_long }}{% if language != blank %} · in {{ language }}{% endif %}</span>
  {% else %}
  <span class='title'>{{ title }}</span>
  <span class='instance'>{{ target_label }}</span>
  {% endif %}
</div>
