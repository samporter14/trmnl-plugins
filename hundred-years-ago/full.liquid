{% if ok %}
<div class='layout layout--col layout--top portrait:hidden'>
  <img class='image image-dither w--full' src='{{ image_top }}' alt='{{ paper }}, {{ date_label }}, front page' />
</div>
<div class='layout layout--col layout--center hidden portrait:flex'>
  <img class='image image-dither image--contain w--full h--full' src='{{ image_page }}' alt='{{ paper }}, {{ date_label }}, front page' />
</div>
{% else %}
<div class='layout layout--col layout--center gap--small'>
  <span class='title lg:title--large text--center'>{{ empty_msg }}</span>
  <span class='description lg:description--large text--center'>Front pages come from Chronicling America at the Library of Congress. Pick another paper in the plugin settings.</span>
</div>
{% endif %}
<div class='title_bar'>
  <img class='image' src='data:image/svg+xml;base64,{{ hya_icon | base64_encode }}' />
  {% if ok %}
  <span class='title'>{{ paper }}<span class='portrait:hidden'>{% if place != blank %}, {{ place }}{% endif %}</span></span>
  <span class='instance portrait:hidden'>{{ date_label }} · {{ when_long }}</span>
  <span class='instance hidden portrait:block'>{{ date_short }} · {{ when_short }}</span>
  {% else %}
  <span class='title'>{{ title }}</span>
  <span class='instance'>{{ target_label }}</span>
  {% endif %}
</div>
